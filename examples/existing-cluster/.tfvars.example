castai_api_token = "your-castai-api-token"
castai_api_url   = "https://api.cast.ai"
organization_id  = "your-castai-organization-id"
cluster_id       = "your-castai-cluster-id"

parent_id                = "your-nebius-project-id"
nebius_service_account_id = "your-nebius-service-account-id"
nebius_public_key_id     = "your-nebius-public-key-id"
nebius_private_key_path  = "path/to/nebius-private-key.pem"

