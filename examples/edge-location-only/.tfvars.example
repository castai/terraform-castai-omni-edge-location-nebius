# Copy to .tfvars and fill in.

castai_api_token = "castai-api-token"
castai_api_url   = "castai-api-url"

organization_id = "castai-organization-id"
cluster_id      = "castai-cluster-id"
name            = "my-edge-location"

# Handoff bundle from the cloud-resources run.
nebius_parent_id          = "project-xxxxxxxxxxxxxxxxxxxxxxxxxx"
region                    = "eu-north1"
nebius_service_account_id = "serviceaccount-xxxxxxxxxxxxxxxxxxxxx"
nebius_network_id         = "vpcnetwork-xxxxxxxxxxxxxxxxxxxxxxxxxxx"
nebius_subnet_id          = "vpcsubnet-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
nebius_subnet_cidr        = "10.0.0.0/24"
nebius_security_group_id  = "vpcsecuritygroup-xxxxxxxxxxxxxxxxxxxxxxx"